# LIM Digital Platform - environment template
# Copy to .env for local development. Never commit real secrets.

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="replace-with-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated CORS allowlist for /api/v1 (defaults to http://localhost:3000 when unset)
API_ALLOWED_ORIGINS="http://localhost:3000"

# Upstash Redis (rate limit + idempotency for /api/v1)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3-compatible uploads for POST /api/v1/uploads/presign
# Works with Cloudflare R2 or Supabase Storage S3 endpoint (server-side only; bypasses RLS)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_ENDPOINT=""
R2_REGION=""
# R2_FORCE_PATH_STYLE=true  # optional; auto-enabled for non-R2 endpoints

# Neon Realtime (optional, for /api/realtime)
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""

# Neon Functions routing (dipakai /api/function). Ambil dari branch Neon yang aktif.
# NEON_FUNCTION_HOST_SUFFIX harus memakai titik di depan, mis. ".compute.c-3.ap-southeast-1.aws.neon.tech"
NEON_BRANCH_ID=""
NEON_FUNCTION_HOST_SUFFIX=""
