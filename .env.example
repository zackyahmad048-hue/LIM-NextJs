# =============================================================================
# LIM Website - Environment Variables
# =============================================================================
# Copy this file to ".env" and fill in the appropriate values.
#
# Windows:
#   copy .env.example .env
#
# Linux / macOS:
#   cp .env.example .env
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================
# PostgreSQL / Neon (schema menggunakan PostgreSQL, bukan SQLite).
# DATABASE_URL="postgresql://username:password@host:5432/database"

# Neon (connection string dari dashboard Neon; pakai pooler untuk dev).
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"


# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV="development"

APP_NAME="LIM Website"

APP_URL="http://localhost:3000"


# =============================================================================
# BETTER AUTH
# =============================================================================
# Generate a secure random string.
# Example:
# openssl rand -base64 32
#
# Never commit the real value to GitHub.
BETTER_AUTH_SECRET="your-super-secret-key"

# Local Development
BETTER_AUTH_URL="http://localhost:3000"


# =============================================================================
# GITHUB OAUTH
# =============================================================================
# Create OAuth App:
# https://github.com/settings/developers

GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"


# =============================================================================
# GOOGLE OAUTH (Optional)
# =============================================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# =============================================================================
# GOOGLE SHEETS INTEGRATION (Pendataan Sekretariat & Data Falak)
# =============================================================================
# Service account yang diberikan akses (Editor) ke spreadsheet pendataan &
# spreadsheet falak untuk reporting satu arah (PG -> Sheets).
# Private key dari service account JSON, dengan \n ditulis sebagai literal \n.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="nama@project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Catatan: service account tidak bisa membuat file Drive/Docs di akun konsumen
# (tanpa storage quota). Reporting hanya menulis ke spreadsheet yang di-share.
# Dokumen surat dicetak/di-PDF in-app; file disimpan di Vercel Blob.
#
# ID spreadsheet (lihat kolom pertama di dokumen spec).
# GOOGLE_SPREADSHEET_PENDATAAN_ID=""
# GOOGLE_SPREADSHEET_FALAK_ID=""


# =============================================================================
# EMAIL (Optional)
# =============================================================================
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noreply@example.com"


# =============================================================================
# OPENAI (Optional)
# =============================================================================
# OPENAI_API_KEY="your-openai-api-key"


# =============================================================================
# VERCEL
# =============================================================================
# Leave empty for local development.
# Configure these values inside the Vercel Dashboard.

# VERCEL_URL=""
# VERCEL_ENV=""

# =============================================================================
# VERCEL BLOB (Surat-menyurat QR)
# =============================================================================
# Token read-write Vercel Blob untuk menyimpan file surat + QR.
# Buat di dashboard Vercel (Storage -> Blob) atau `npx vercel blobs`.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
