{
  "name": "my-app",
  "description": "workspace check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_OPTIONS=--max-old-space-size=4096 next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && tsx prisma/seed.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "setup:google": "node scripts/setup-google.mjs",
    "gen:cities": "node scripts/gen-cities.mjs",
    "test:watch": "vitest",
    "test": "vitest run",
    "a11y:scan": "vitest run tests/accessibility/axe.scan.test.ts",
    "e2e": "vitest run tests/accessibility",
    "e2e:watch": "vitest watch tests/accessibility"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@better-auth/prisma-adapter": "^1.6.23",
    "@hookform/resolvers": "^5.4.0",
    "@napi-rs/canvas": "^0.1.100",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/blob": "^2.6.1",
    "adhan": "^4.4.4",
    "antd": "^6.6.2",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^16.4.5",
    "googleapis": "^173.0.0",
    "hijri-converter": "^1.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.43.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.81.0",
    "react-icons": "^5.7.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.62.1",
    "prettier": "^3.9.5",
    "prisma": "^7.9.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@tsparticles/engine@4.3.2": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5"
  }
}
