{
  "name": "my-app",
  "description": "workspace check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && NODE_OPTIONS=--max-old-space-size=4096 next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:deploy": "prisma migrate deploy && tsx prisma/seed.ts",
    "setup:google": "node scripts/setup-google.mjs",
    "gen:cities": "node scripts/gen-cities.mjs",
    "test:watch": "vitest",
    "test": "vitest run",
    "e2e": "vitest run tests/e2e",
    "e2e:watch": "vitest tests/e2e"
  },
  "dependencies": {
