generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String           @id @default(cuid())
  roleId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("settings")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  emailVerified Boolean    @default(false)
  image         String?
  accounts      Account[]
  auditLogs     AuditLog[]
  posts         Post[]
  sessions      Session[]
  userRoles     UserRole[]
  programs      Program[]  @relation("PersonInCharge")
  committees    ProgramCommittee[]
  participants  Participant[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       Post[]

  @@map("categories")
}


model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  thumbnail   String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([authorId])
  @@map("posts")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PUBLISH
  UNPUBLISH
  VERIFY
  IMPORT
  EXPORT
  OPEN
  CLOSE
  COMPLETE
  CANCEL
  ARCHIVE
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ON_GOING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CommitteeStatus {
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PrayerMethod {
  KEMENAG
  MUHAMMADIYAH
  UMMAH_AL_QURA
  EGYPTIAN
  ISNA
  MWL
}

enum ObservationStatus {
  DRAFT
  VERIFIED
  CONFIRMED
  ARCHIVED
}

enum RukyatResult {
  VISIBLE
  NOT_VISIBLE
  CLOUDY
  UNKNOWN
}

enum EclipseType {
  SOLAR
  LUNAR
}

enum HijriMethod {
  HISAB
  RUKYAT
  IMKANUR_RUKYAT
  WUJUDUL_HILAL
}

enum IncomingMailStatus {
  RECEIVED
  PROCESSED
  ARCHIVED
}

enum OutgoingMailStatus {
  DRAFT
  APPROVED
  SENT
  ARCHIVED
}

enum DispositionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AdministrativeDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocumentType {
  UNDANGAN
  PERMOHONAN
  PEMBERITAHUAN
  INSTRUKSI
  KETERANGAN
  KEPUTUSAN
  TERIMA_KASIH
  LAINNYA
}

model FalakPrayerTime {
  id                String      @id @default(cuid())
  locationName      String
  latitude          Float
  longitude         Float
  timezone          String
  calculationMethod PrayerMethod
  prayerDate        DateTime
  fajr              DateTime
  sunrise           DateTime
  dhuhr             DateTime
  asr               DateTime
  maghrib           DateTime
  isha              DateTime
  createdAt         DateTime    @default(now())

  @@index([prayerDate])
  @@index([latitude, longitude])
  @@map("falak_prayer_time")
}

model FalakQibla {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  direction Float
  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@map("falak_qibla")
}

model FalakHijriCalendar {
  id            String     @id @default(cuid())
  gregorianDate DateTime
  hijriYear     Int
  hijriMonth    Int
  hijriDay      Int
  method        HijriMethod
  createdAt     DateTime   @default(now())

  @@index([gregorianDate])
  @@unique([gregorianDate, method])
  @@map("falak_hijri_calendar")
}

model FalakHisab {
  id              String   @id @default(cuid())
  calculationDate DateTime
  locationName    String
  latitude        Float
  longitude       Float
  parameters      Json
  result          Json
  calculatedById  String?
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  @@index([calculationDate])
  @@map("falak_hisab")
}

model FalakRukyat {
  id              String           @id @default(cuid())
  observationDate DateTime
  locationName    String
  latitude        Float
  longitude       Float
  observerId      String
  weather         String
  result          RukyatResult
  notes           String?
  status          ObservationStatus @default(DRAFT)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?

  @@index([observationDate])
  @@index([status])
  @@map("falak_rukyat")
}

model FalakEclipse {
  id          String      @id @default(cuid())
  eclipseType EclipseType
  eclipseDate DateTime
  visibility  String?
  details     Json?
  createdAt   DateTime    @default(now())

  @@index([eclipseDate])
  @@map("falak_eclipse")
}

model Imsakiyah {
  id             String   @id @default(cuid())
  no             Int
  gregorianDate  DateTime
  dayName        String
  javaneseDay    String
  ramadanDay     Int
  hijriDate      Int
  hijriMonth     String
  hijriYear      String
  province       String
  city           String
  latitude       Float
  longitude      Float
  elevation      Float?
  googleMapsLink String?
  imsak          String
  subuh          String
  terbit         String
  dhuha          String
  dzuhur         String
  ashar          String
  maghrib        String
  isya           String
  moonPhase      String?
  eclipseData    String?
  eclipseTime    String?
  hilalAltitude  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([gregorianDate])
  @@map("imsakiyah")
}

model Program {
  id                String        @id @default(cuid())
  code              String        @unique
  name              String
  type              String
  description       String?
  organizerId       String?
  personInChargeId  String?
  status            ProgramStatus @default(DRAFT)
  registrationOpen  DateTime?
  registrationClose DateTime?
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  personInCharge User?              @relation("PersonInCharge", fields: [personInChargeId], references: [id])
  schedules      ProgramSchedule[]
  committees     ProgramCommittee[]
  participants   Participant[]
  documentation  ProgramDocumentation[]

  @@index([status])
  @@index([startDate])
  @@map("program")
}

model ProgramSchedule {
  id          String   @id @default(cuid())
  programId   String
  title       String
  venueId     String?
  startTime   DateTime
  endTime     DateTime
  description String?
  deletedAt   DateTime?
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_schedule")
}

model ProgramCommittee {
  id          String          @id @default(cuid())
  programId   String
  userId      String
  role        String
  status      CommitteeStatus @default(ACTIVE)
  deletedAt   DateTime?
  program     Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id])

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@map("program_committee")
}

model Participant {
  id                 String             @id @default(cuid())
  programId          String
  userId             String
  registrationDate   DateTime           @default(now())
  registrationStatus RegistrationStatus @default(PENDING)
  deletedAt          DateTime?
  program            Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id])
  attendance         Attendance[]

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@map("participant")
}

model Attendance {
  id            String           @id @default(cuid())
  participantId String
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("attendance")
}

model ProgramDocumentation {
  id          String   @id @default(cuid())
  programId   String
  mediaId     String?
  title       String
  description String?
  deletedAt   DateTime?
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_documentation")
}

model IncomingMail {
  id               String              @id @default(cuid())
  registrationNumber String            @unique
  sender           String
  subject          String
  senderAddress    String?
  receivedDate     DateTime
  status           IncomingMailStatus  @default(RECEIVED)
  classification   String?
  category         String?
  notes            String?
  attachmentUrl    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  dispositions     Disposition[]

  @@index([status])
  @@index([receivedDate])
  @@index([registrationNumber])
  @@map("incoming_mail")
}

model OutgoingMail {
  id                 String              @id @default(cuid())
  registrationNumber String              @unique
  recipient          String?
  subject            String
  senderName         String?
  mailDate           DateTime
  status             OutgoingMailStatus  @default(DRAFT)
  documentNumber     String?
  documentType       DocumentType?
  content            String?
  approvedById       String?
  approvedAt         DateTime?
  attachmentUrl      String?
  googleDocId        String?
  googleDocUrl       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?

  @@index([status])
  @@index([mailDate])
  @@index([registrationNumber])
  @@map("outgoing_mail")
}

model Disposition {
  id              String             @id @default(cuid())
  incomingMailId  String
  assignedToId    String
  instruction     String
  priority        String             @default("NORMAL")
  status          DispositionStatus  @default(PENDING)
  dueDate         DateTime?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  incomingMail    IncomingMail       @relation(fields: [incomingMailId], references: [id], onDelete: Cascade)

  @@index([incomingMailId])
  @@index([assignedToId])
  @@index([status])
  @@map("disposition")
}

model AdministrativeDocument {
  id               String                      @id @default(cuid())
  documentNumber   String                      @unique
  documentType     DocumentType
  title            String
  description      String?
  content          String?
  status           AdministrativeDocumentStatus @default(DRAFT)
  submittedById    String?
  submittedAt      DateTime?
  approvedById     String?
  approvedAt       DateTime?
  googleDocId      String?
  googleDocUrl     String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  deletedAt        DateTime?

  @@index([status])
  @@index([documentType])
  @@index([documentNumber])
  @@map("administrative_document")
}

model AgendaBook {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  description String?
  location    String?
  participants String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("agenda_book")
}

model DocumentArchive {
  id             String     @id @default(cuid())
  archiveNumber  String     @unique
  title          String
  documentType   DocumentType
  category       String?
  retentionYear  Int?
  archivedAt     DateTime   @default(now())
  createdAt      DateTime   @default(now())

  @@index([archiveNumber])
  @@index([documentType])
  @@map("document_archive")
}
