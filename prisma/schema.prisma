generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String           @id @default(cuid())
  roleId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Setting {
  id          String      @id @default(cuid())
  key         String      @unique
  value       String
  type        SettingType @default(STRING)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("settings")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String?
  action      AuditAction
  entity      String
  entityId    String?
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@map("audit_logs")
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  emailVerified Boolean            @default(false)
  image         String?
  accounts      Account[]
  auditLogs     AuditLog[]
  media         Media[]
  participants  Participant[]
  posts         Post[]
  programs      Program[]          @relation("PersonInCharge")
  committees    ProgramCommittee[]
  sessions      Session[]
  userRoles     UserRole[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  issuer                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  posts       Post[]

  @@map("categories")
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  thumbnail   String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  categoryId  String
  authorId    String
  deletedAt   DateTime?
  author      User      @relation(fields: [authorId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([authorId])
  @@map("posts")
}

model WajibKhidmahLembaga {
  id                            String                         @id @default(cuid())
  namaLembagaPendidikan         String
  rtRw                          String?
  desaKelurahan                 String?
  kecamatan                     String?
  kabupatenKota                 String?
  provinsi                      String?
  teleponLembaga                String?
  mediaSosialLembaga            String?
  pengasuhNama                  String?
  pengasuhStatus                WajibKhidmahStatusPemohon?
  pengasuhStatusLainnya         String?
  pengasuhAlumniAngkatan        String?
  pengasuhTelepon               String?
  pengasuhFotoFileId            String?
  penanggungJawabNama           String?
  penanggungJawabStatus         WajibKhidmahStatusPemohon?
  penanggungJawabStatusLainnya  String?
  penanggungJawabAlumniAngkatan String?
  penanggungJawabTelepon        String?
  penanggungJawabFotoFileId     String?
  lokasiMadrasah                WajibKhidmahLokasiMadrasah?
  jenisSatuanPendidikan         WajibKhidmahSatuanPendidikan[] @default([])
  jenisSatuanPendidikanLainnya  String?
  kitabBermakna                 String[]                       @default([])
  kitabBermaknaLainnya          String?
  bahasaPengantar               String[]                       @default([])
  bahasaPengantarLainnya        String?
  jumlahPengurusPutra           Int?
  jumlahPengurusPutri           Int?
  jumlahSantriPutra             Int?
  jumlahSantriPutri             Int?
  jumlahGuruBantuDimohon        Int
  tugasGuruBantu                String?
  kitabDiajarkanGuruBantu       String?
  catatanCalonGuruBantu         String?
  dokumenPermohonanFileId       String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  members                       WajibKhidmahMember[]

  @@map("wajib_khidmah_lembaga")
}

model WajibKhidmahMember {
  id                 String               @id @default(cuid())
  nama               String
  asalDaerah         String?
  posWajibKhidmah    String?
  tempatWajibKhidmah String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  absensi            String?
  alamatLembaga      String?
  catatan            String?
  keterangan         String?
  status             WajibKhidmahStatus   @default(AKTIF)
  tugasKhidmah       String?
  lembagaId          String?
  lembaga            WajibKhidmahLembaga? @relation(fields: [lembagaId], references: [id])

  @@index([status])
  @@index([lembagaId])
  @@map("wajib_khidmah_members")
}

model FalakPrayerTime {
  id                String       @id @default(cuid())
  locationName      String
  latitude          Float
  longitude         Float
  timezone          String
  calculationMethod PrayerMethod
  prayerDate        DateTime
  fajr              DateTime
  sunrise           DateTime
  dhuhr             DateTime
  asr               DateTime
  maghrib           DateTime
  isha              DateTime
  createdAt         DateTime     @default(now())

  @@index([prayerDate])
  @@index([latitude, longitude])
  @@map("falak_prayer_time")
}

model FalakQibla {
  id        String   @id @default(cuid())
  latitude  Float
  longitude Float
  direction Float
  createdAt DateTime @default(now())

  @@index([latitude, longitude])
  @@map("falak_qibla")
}

model FalakHijriCalendar {
  id            String      @id @default(cuid())
  gregorianDate DateTime
  hijriYear     Int
  hijriMonth    Int
  hijriDay      Int
  method        HijriMethod
  createdAt     DateTime    @default(now())

  @@unique([gregorianDate, method])
  @@index([gregorianDate])
  @@map("falak_hijri_calendar")
}

model FalakHisab {
  id              String    @id @default(cuid())
  calculationDate DateTime
  locationName    String
  latitude        Float
  longitude       Float
  parameters      Json
  result          Json
  calculatedById  String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@index([calculationDate])
  @@map("falak_hisab")
}

model FalakRukyat {
  id              String            @id @default(cuid())
  observationDate DateTime
  locationName    String
  latitude        Float
  longitude       Float
  observerId      String
  weather         String
  result          RukyatResult
  notes           String?
  status          ObservationStatus @default(DRAFT)
  createdAt       DateTime          @default(now())
  deletedAt       DateTime?

  @@index([observationDate])
  @@index([status])
  @@map("falak_rukyat")
}

model FalakEclipse {
  id          String      @id @default(cuid())
  eclipseType EclipseType
  eclipseDate DateTime
  visibility  String?
  details     Json?
  createdAt   DateTime    @default(now())

  @@index([eclipseDate])
  @@map("falak_eclipse")
}

model Program {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  type              String
  description       String?
  organizerId       String?
  personInChargeId  String?
  status            ProgramStatus          @default(DRAFT)
  registrationOpen  DateTime?
  registrationClose DateTime?
  startDate         DateTime
  endDate           DateTime
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  participants      Participant[]
  personInCharge    User?                  @relation("PersonInCharge", fields: [personInChargeId], references: [id])
  committees        ProgramCommittee[]
  documentation     ProgramDocumentation[]
  schedules         ProgramSchedule[]

  @@index([status])
  @@index([startDate])
  @@map("program")
}

model ProgramSchedule {
  id          String    @id @default(cuid())
  programId   String
  title       String
  venueId     String?
  startTime   DateTime
  endTime     DateTime
  description String?
  deletedAt   DateTime?
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_schedule")
}

model ProgramCommittee {
  id        String          @id @default(cuid())
  programId String
  userId    String
  role      String
  status    CommitteeStatus @default(ACTIVE)
  deletedAt DateTime?
  program   Program         @relation(fields: [programId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@map("program_committee")
}

model Participant {
  id                 String             @id @default(cuid())
  programId          String
  userId             String
  registrationDate   DateTime           @default(now())
  registrationStatus RegistrationStatus @default(PENDING)
  deletedAt          DateTime?
  attendance         Attendance[]
  program            Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id])

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@map("participant")
}

model Attendance {
  id            String           @id @default(cuid())
  participantId String
  checkIn       DateTime?
  checkOut      DateTime?
  status        AttendanceStatus
  participant   Participant      @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@map("attendance")
}

model ProgramDocumentation {
  id          String    @id @default(cuid())
  programId   String
  mediaId     String?
  title       String
  description String?
  deletedAt   DateTime?
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_documentation")
}

model IncomingMail {
  id                 String             @id @default(cuid())
  registrationNumber String             @unique
  sender             String
  subject            String
  senderAddress      String?
  receivedDate       DateTime
  status             IncomingMailStatus @default(RECEIVED)
  classification     String?
  category           String?
  notes              String?
  attachmentUrl      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  archivedAt         DateTime?
  dispositions       Disposition[]

  @@index([status])
  @@index([receivedDate])
  @@index([registrationNumber])
  @@map("incoming_mail")
}

model OutgoingMail {
  id                   String             @id @default(cuid())
  registrationNumber   String             @unique
  recipient            String?
  subject              String
  senderName           String?
  mailDate             DateTime
  status               OutgoingMailStatus @default(DRAFT)
  documentType         DocumentType?
  content              String?
  attachmentUrl        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  archivedAt           DateTime?
  categoryCode         String?
  fullNumber           String?            @unique
  levelCode            String?
  periodYear           Int?
  qrFileId             String?
  romanMonth           String?
  sentAt               DateTime?
  sequence             Int?
  verificationCode     String?            @unique
  ketuaName            String?
  ketuaPosition        String?
  qrKetuaPosition      Json?
  qrSekretarisPosition Json?
  qrVerifikasiPosition Json?
  sekretarisName       String?
  sekretarisPosition   String?

  @@unique([periodYear, sequence])
  @@index([status])
  @@index([mailDate])
  @@index([registrationNumber])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("outgoing_mail")
}

model Disposition {
  id             String            @id @default(cuid())
  incomingMailId String
  assignedToId   String
  instruction    String
  priority       String            @default("NORMAL")
  status         DispositionStatus @default(PENDING)
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  incomingMail   IncomingMail      @relation(fields: [incomingMailId], references: [id], onDelete: Cascade)

  @@index([incomingMailId])
  @@index([assignedToId])
  @@index([status])
  @@map("disposition")
}

model AdministrativeDocument {
  id             String                       @id @default(cuid())
  documentNumber String                       @unique
  documentType   DocumentType
  title          String
  description    String?
  content        String?
  status         AdministrativeDocumentStatus @default(DRAFT)
  submittedById  String?
  submittedAt    DateTime?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt
  deletedAt      DateTime?
  archivedAt     DateTime?
  attachmentUrl  String?

  @@index([status])
  @@index([documentType])
  @@index([documentNumber])
  @@map("administrative_document")
}

model AgendaBook {
  id           String    @id @default(cuid())
  date         DateTime
  title        String
  description  String?
  location     String?
  participants String?
  notes        String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([date])
  @@map("agenda_book")
}

model DocumentArchive {
  id            String       @id @default(cuid())
  archiveNumber String       @unique
  title         String
  documentType  DocumentType
  category      String?
  retentionYear Int?
  archivedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())
  deletedAt     DateTime?

  @@index([archiveNumber])
  @@index([documentType])
  @@map("document_archive")
}

model Media {
  id              String          @id @default(cuid())
  originalName    String
  mimeType        String
  size            Int
  checksum        String?
  fileId          String          @unique
  access          MediaAccess     @default(PRIVATE)
  folder          String
  uploadedById    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  storageKey      String?
  storageProvider StorageProvider @default(BLOB)
  uploadedBy      User?           @relation(fields: [uploadedById], references: [id])

  @@index([folder])
  @@index([uploadedById])
  @@map("media")
}

model GoogleDriveConnection {
  id              String   @id @default(cuid())
  email           String
  refreshToken    String
  driveFolderId   String?
  driveFolderName String?
  connectedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("google_drive_connection")
}

model OrganizationUnit {
  id        String             @id @default(cuid())
  code      String             @unique
  name      String
  level     UnitLevel
  parentId  String?
  sortOrder Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?
  officers  Officer[]
  parent    OrganizationUnit?  @relation("UnitTree", fields: [parentId], references: [id])
  children  OrganizationUnit[] @relation("UnitTree")

  @@index([parentId])
  @@index([level])
  @@index([deletedAt])
  @@map("organization_unit")
}

model Officer {
  id        String           @id @default(cuid())
  unitId    String
  name      String
  position  String
  isLeader  Boolean          @default(false)
  phone     String?
  email     String?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?
  unit      OrganizationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([deletedAt])
  @@map("officer")
}

model bb {
  order                          Int                            @map("_order")
  parent_id                      Int                            @map("_parent_id")
  id                             String                         @id(map: "payload_organization_structure_branch_boards_pkey") @db.VarChar
  province                       String                         @db.VarChar
  regency                        String                         @db.VarChar
  name                           String                         @db.VarChar
  payload_organization_structure payload_organization_structure @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bb_parent_id_fk")
  bb_members                     bb_members[]

  @@index([order], map: "bb_order_idx")
  @@index([parent_id], map: "bb_parent_id_idx")
}

model bb_members {
  order      Int     @map("_order")
  parent_id  String  @map("_parent_id") @db.VarChar
  id         String  @id(map: "payload_organization_structure_branch_boards_members_pkey") @db.VarChar
  name       String  @db.VarChar
  position   String  @db.VarChar
  image      String? @db.VarChar
  sort_order Int     @default(0)
  bb         bb      @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "bb_members_parent_id_fk")

  @@index([order], map: "bb_members_order_idx")
  @@index([parent_id], map: "bb_members_parent_id_idx")
}

model jsp {
  order                          Int
  parent_id                      Int
  value                          enum_jsp?
  id                             Int                            @id(map: "payload_wajib_khidmah_lembagas_jenis_satuan_pendidikan_pkey") @default(autoincrement())
  payload_wajib_khidmah_lembagas payload_wajib_khidmah_lembagas @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "jsp_parent_fk")

  @@index([order])
  @@index([parent_id], map: "jsp_parent_idx")
}

model payload_administrative_documents {
  id                            Int                                                 @id @default(autoincrement())
  document_number               String                                              @unique(map: "padocn_docnum_idx") @db.VarChar
  document_type                 enum_payload_administrative_documents_document_type
  title                         String                                              @db.VarChar
  description                   String?                                             @db.VarChar
  content                       String?                                             @db.VarChar
  attachment_url                String?                                             @db.VarChar
  status                        enum_payload_administrative_documents_status        @default(DRAFT)
  submitted_by_id               String?                                             @db.VarChar
  submitted_at                  DateTime?
  approved_by_id                String?                                             @db.VarChar
  approved_at                   DateTime?
  archived_at                   DateTime?
  deleted_at                    DateTime?
  updated_at                    DateTime                                            @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                                            @default(now()) @db.Timestamptz(3)
  payload_locked_documents_rels payload_locked_documents_rels[]

  @@index([document_type], map: "padocn_doctype_idx")
  @@index([status], map: "padocn_status_idx")
}

model payload_agenda_books {
  id                            Int                             @id @default(autoincrement())
  date                          DateTime
  title                         String                          @db.VarChar
  description                   String?                         @db.VarChar
  location                      String?                         @db.VarChar
  participants                  String?                         @db.VarChar
  notes                         String?                         @db.VarChar
  deleted_at                    DateTime?
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  payload_locked_documents_rels payload_locked_documents_rels[]

  @@index([date], map: "pab_date_idx")
  @@index([deleted_at], map: "pab_deleted_idx")
}

model payload_attendances {
  id                            Int                             @id @default(autoincrement())
  participant_id                Int
  check_in                      DateTime?
  check_out                     DateTime?
  status                        enum_payload_attendances_status
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  payload_participants          payload_participants            @relation(fields: [participant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "patt_participant_fk")
  payload_locked_documents_rels payload_locked_documents_rels[]

  @@index([participant_id], map: "patt_participant_idx")
}

model payload_bidangs {
  id                            Int                             @id @default(autoincrement())
  slug                          String                          @unique(map: "payload_bidangs_slug_idx") @db.VarChar
  title                         String                          @db.VarChar
  tagline                       String?                         @db.VarChar
  description                   String?                         @db.VarChar
  sort_order                    Int                             @default(0)
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  payload_bidangs_points        payload_bidangs_points[]
  payload_locked_documents_rels payload_locked_documents_rels[]

  @@index([created_at])
  @@index([updated_at])
}

model payload_bidangs_points {
  order           Int             @map("_order")
  parent_id       Int             @map("_parent_id")
  id              String          @id @db.VarChar
  value           String?         @db.VarChar
  payload_bidangs payload_bidangs @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payload_bidangs_points_parent_id_fk")

  @@index([order], map: "payload_bidangs_points_order_idx")
  @@index([parent_id], map: "payload_bidangs_points_parent_id_idx")
}

model payload_categories {
  id                            Int                             @id @default(autoincrement())
  name                          String                          @db.VarChar
  slug                          String                          @unique(map: "payload_categories_slug_idx") @db.VarChar
  description                   String?                         @db.VarChar
  updated_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(3)
  payload_locked_documents_rels payload_locked_documents_rels[]
  payload_posts                 payload_posts[]

  @@index([created_at])
  @@index([updated_at])
}

model payload_dispositions {
  id                            Int                              @id @default(autoincrement())
  incoming_mail_id              Int
  assigned_to_id                String                           @db.VarChar
  instruction                   String                           @db.VarChar
  priority                      String                           @default("NORMAL") @db.VarChar
  status                        enum_payload_dispositions_status @default(PENDING)
  due_date                      DateTime?
  notes                         String?                          @db.VarChar
  deleted_at                    DateTime?
  updated_at                    DateTime                         @default(now()) @db.Timestamptz(3)
  created_at                    DateTime                         @default(now()) @db.Timestamptz(3)
  payload_incoming_mails        payload_incoming_mails           @relation(fields: [incoming_mail_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "disp_imail_fk")
  payload_locked_documents_rels payload_locked_documents_rels[]

