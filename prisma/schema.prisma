// ============================================
// LIM DIGITAL PLATFORM — MASTER PRISMA SCHEMA
// Next.js 16 + Prisma 6 + Neon PostgreSQL
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// 1. ENUMS GLOBAL & ROLE
// ============================================

enum Role {
  // === LEVEL PUSAT (PP) ===
  OWNER
  ADMIN_SEKRETARIAT
  TIM_WAJIB_KHIDMAH
  CONTENT_MANAGER
  ADMIN_BIDANG_SAFARI
  ADMIN_BIDANG_PESANTREN_RAMADAN
  // === LEVEL WILAYAH & CABANG ===
  PW
  PC
  // === ROLE OPERASIONAL (Temporer per Kegiatan) ===
  PANITIA_SAFARI_DAERAH
  DELEGASI_SAFARI_DAERAH
  PENGAJAR_PESANTREN_RAMADAN
  // === ROLE PENDIDIKAN & LEMBAGA ===
  GURU_BANTU
  LEMBAGA_EKSTERNAL
  PONDOK_INTERNAL
}

enum AccountType {
  PERSONAL
  ORGANIZATIONAL
}

// ============================================
// 2. MODELS: AUTHENTICATION (Better Auth Compatible)
// ============================================

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          Role        @default(GURU_BANTU)
  accountType   AccountType @default(PERSONAL)
  twoFactorEnabled Boolean  @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]

  guruBantuProfile            GuruBantuProfile?
  organizationalAccount       OrganizationalAccount?
  penugasanStruktural         PenugasanStruktural[]
  laporanDibuat               LaporanMingguan[]
  kasusDitangani              EvaluasiKasus[]        @relation("Mediator")
  evaluasiDibuat              EvaluasiInduk[]        @relation("Evaluator")
  kasusDiinisiasi             EvaluasiInduk[]        @relation("Initiator")
  permohonanDibuat            PermohonanGuruBantu[]
  lettersCreated              Letter[]               @relation("LetterCreator")
  lettersReviewed             Letter[]               @relation("LetterReviewer")
  lettersApproved             Letter[]               @relation("LetterApprover")
  letterLogs                  LetterLog[]
  articlesWritten             Article[]
  delegasiSafari              DelegasiSafari[]
  laporanSidak                LaporanSidak[]
  penugasanSebagaiPengajar    PenugasanPesantren[]   @relation("PengajarPesantren")
  penugasanSebagaiKoordinator PenugasanPesantren[]   @relation("KoordinatorPesantren")
  penilaianPusat              UmpanBalikPusat[]
  kontenDiunggah              KontenDakwah[]         @relation("PengunggahKonten")
  kontenDisetujui             KontenDakwah[]         @relation("PenyetujuKonten")
  laporanBinaan               LaporanBulananBinaan[]
  auditLogs                   AuditLog[]
  lembagaOwned                Lembaga?
  lembagaCreated              Lembaga[]              @relation("LembagaCreator")
  lembagaUpdated              Lembaga[]              @relation("LembagaUpdater")
  daerahBinaanPic             DaerahBinaan[]
  penugasanDitanggung         Penugasan[]            @relation("DosenPenanggung")
  penugasanDibuat             Penugasan[]            @relation("PenugasanCreator")
  penugasanDiperbarui         Penugasan[]            @relation("PenugasanUpdater")
  laporanMingguanDibuat       LaporanMingguan[]      @relation("LaporanMingguanCreator")
  laporanMingguanDiperbarui   LaporanMingguan[]      @relation("LaporanMingguanUpdater")
  lettersUpdated              Letter[]               @relation("LetterUpdater")
  riwayatDibuat               RiwayatPermohonan[]

  @@index([email])
  @@index([role])
  @@index([accountType])
  @@map("User")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// ============================================
// 3. MODELS: BASIS DATA KEPENGURUSAN
// ============================================

model PeriodeKhidmat {
  id           String   @id @default(cuid())
  namaPeriode  String
  tahunMulai   Int
  tahunSelesai Int
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  penugasanStruktural PenugasanStruktural[]
  letterPeriod        LetterPeriod[]

  @@index([isActive])
}

model UnitOrganisasi {
  id        String   @id @default(cuid())
  namaUnit  String
  levelCode String   @unique
  wilayah   String?
  deskripsi String?  @db.Text
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  parent                UnitOrganisasi?         @relation("UnitOrganisasiHierarchy", fields: [parentId], references: [id])
  children              UnitOrganisasi[]        @relation("UnitOrganisasiHierarchy")
  jabatan               Jabatan[]
  organizationalAccount OrganizationalAccount?
  lembaga               Lembaga[]
  letters               Letter[]
  penugasan             Penugasan[]
  laporanMingguan       LaporanMingguan[]
  permohonanGuruBantu   PermohonanGuruBantu[]
  evaluasiKasus         EvaluasiKasus[]
  evaluasiInduk         EvaluasiInduk[]
  titikSafari           TitikSafari[]
  delegasiSafari        DelegasiSafari[]
  sekolahMitra          SekolahMitra[]
  penugasanPesantren    PenugasanPesantren[]
  kontenDakwah          KontenDakwah[]
  daerahBinaan          DaerahBinaan[]

  @@index([levelCode])
  @@index([parentId])
}

model Bidang {
  id         String   @id @default(cuid())
  namaBidang String
  kodeBidang String   @unique
  urutan     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  jabatan Jabatan[]

  @@index([kodeBidang])
}

model Jabatan {
  id             String   @id @default(cuid())
  unitId         String
  bidangId       String?
  namaJabatan    String
  urutanTampilan Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  unit                UnitOrganisasi        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bidang              Bidang?               @relation(fields: [bidangId], references: [id])
  penugasanStruktural PenugasanStruktural[]

  @@index([unitId])
  @@index([bidangId])
}

model PenugasanStruktural {
  id             String    @id @default(cuid())
  userId         String
  jabatanId      String
  periodeId      String
  tanggalMulai   DateTime  @default(now())
  tanggalSelesai DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jabatan Jabatan        @relation(fields: [jabatanId], references: [id], onDelete: Cascade)
  periode PeriodeKhidmat @relation(fields: [periodeId], references: [id], onDelete: Cascade)

  @@unique([userId, jabatanId, periodeId])
  @@index([userId])
  @@index([jabatanId])
  @@index([periodeId])
}

model OrganizationalAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  unitId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit UnitOrganisasi @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

// ============================================
// 4. MODELS: WAJIB KHIDMAH & PERMOHONAN
// ============================================

enum StatusPenugasan {
  DIAJUKAN
  DIAKTIFKAN
  SELESAI
  DICABUT
  DIPERPANJANG
  DITOLAK
}

enum StatusHonor {
  SUDAH_SESUAI
  BELUM
  SEBAGIAN
  TIDAK_BERLAKU
}

enum FanIlmu {
  NAHWU
  SHOROF
  FIQIH
  HADITS
  TAUHID
  TAFSIR
  AKHLAQ
  QURAN_HADITS
  LAINNYA
}

enum TingkatKeparahan {
  RINGAN
  SEDANG
  BERAT
}

enum StatusMediasi {
  MENUNGGU_PUSAT
  MEDIASI_CABANG
  EVALUASI_INDUK
  SELESAI
  DICABUT
}

enum StatusPeran {
  ALUMNI_LIRBOYO
  BUKAN_ALUMNI
  WALI_SANTRI
  LAINNYA
}

enum LokasiMadrasah {
  DALAM_PESANTREN
  LUAR_PESANTREN
}

enum JenisPendidikan {
  TPQ
  MADRASAH_DINIYAH
  MI
  MTS
  MA
  SD_PESANTREN
  SMP_PESANTREN
  SMA_PESANTREN
  KMI
  PDF
  LAINNYA
}

enum BahasaKitab {
  JAWA
  MADURA
  SUNDA
  LAINNYA
}

enum BahasaPengantar {
  INDONESIA
  LAINNYA
}

enum KategoriLembaga {
  EKSTERNAL
  INTERNAL
}

enum SubKategoriInternal {
  PONDOK_INDUK
  PONDOK_UNIT
  PONDOK_CABANG_NON_ZONASI
  PONDOK_CABANG_ZONASI
  MHM
  MAHAD_ALY
}

enum StatusLembaga {
  CALON
  MITRA_AKTIF
  NON_AKTIF
}

model GuruBantuProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  tempatLahir  String
  tanggalLahir DateTime
  asalPondok   String
  noRekening   String?
  catatanDosen String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  riwayatAkademik  RiwayatAkademik[]
  penugasanKeluar  Penugasan[]
  riwayatGuruBantu RiwayatGuruBantu[]

  @@index([userId])
}

model RiwayatAkademik {
  id           String           @id @default(cuid())
  guruBantuId  String
  jenjang      String
  lembagaAsal  String
  tahunLulus   Int
  jurusanFokus String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt
  guruBantu    GuruBantuProfile @relation(fields: [guruBantuId], references: [id], onDelete: Cascade)

  @@index([guruBantuId])
}

model Lembaga {
  id            String  @id @default(cuid())
  userId        String? @unique
  unitId        String?
  namaLembaga   String
  namaPimpinan  String
  alamatLengkap String  @db.Text
  koordinat     String?

  kategori      KategoriLembaga
  subKategori   SubKategoriInternal?
  status        StatusLembaga        @default(CALON)
  provinsi      String?
  kabupaten     String?
  catatanKhusus String?              @db.Text

  isDzuriyyah         Boolean @default(false)
  isBlacklist         Boolean @default(false)
  jenisLembaga        String?
  pimpinanAlumniTahun String?

  parentId    String?
  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent         Lembaga?              @relation("LembagaHierarchy", fields: [parentId], references: [id])
  children       Lembaga[]             @relation("LembagaHierarchy")
  unit           UnitOrganisasi?       @relation(fields: [unitId], references: [id])
  createdBy      User?                 @relation("LembagaCreator", fields: [createdById], references: [id])
  updatedBy      User?                 @relation("LembagaUpdater", fields: [updatedById], references: [id])
  user           User?                 @relation(fields: [userId], references: [id])
  penugasanMasuk Penugasan[]
  evaluasiInduk  EvaluasiInduk[]
  permohonan     PermohonanGuruBantu[]
  riwayat        RiwayatPermohonan[]

  @@index([userId])
  @@index([unitId])
  @@index([kategori])
  @@index([status])
  @@index([parentId])
  @@index([createdById])
  @@index([updatedById])
}

model Penugasan {
  id                String @id @default(cuid())
  guruBantuId       String
  lembagaId         String
  dosenPenanggungId String
  unitId            String?

  tanggalMulai         DateTime
  tanggalSelesai       DateTime?
  status               StatusPenugasan @default(DIAJUKAN)
  targetJamaahMingguan Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?

  unit             UnitOrganisasi?   @relation(fields: [unitId], references: [id])
  guruBantu        GuruBantuProfile  @relation(fields: [guruBantuId], references: [id], onDelete: Cascade)
  lembaga          Lembaga           @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  dosenPenanggung  User              @relation("DosenPenanggung", fields: [dosenPenanggungId], references: [id])
  createdBy        User?             @relation("PenugasanCreator", fields: [createdById], references: [id])
  updatedBy        User?             @relation("PenugasanUpdater", fields: [updatedById], references: [id])
  laporanMingguan  LaporanMingguan[]
  evaluasiKasus    EvaluasiKasus[]
  evaluasiInduk    EvaluasiInduk[]
  riwayatGuruBantu RiwayatGuruBantu?

  @@index([guruBantuId])
  @@index([lembagaId])
  @@index([unitId])
  @@index([status])
  @@index([dosenPenanggungId])
  @@index([createdById])
  @@index([updatedById])
}

model LaporanMingguan {
  id          String @id @default(cuid())
  penugasanId String
  pelaporId   String
  rolePelapor Role
  unitId      String?

  namaPengisi    String
  jabatanPengisi String
  periodeMinggu  Int
  periodeTahun   Int
  tanggalLapor   DateTime @default(now())

  jumlahHariHadir       Int
  keteranganAbsensi     String?     @db.Text
  jumlahJamaahDilakukan Int
  aktivitasMingguan     String      @db.Text
  kendala               String?     @db.Text
  statusHonor           StatusHonor
  isForwardedToInduk    Boolean     @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  unit        UnitOrganisasi? @relation(fields: [unitId], references: [id])
  penugasan   Penugasan       @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  pelapor     User            @relation(fields: [pelaporId], references: [id], onDelete: Cascade)
  createdBy   User?           @relation("LaporanMingguanCreator", fields: [createdById], references: [id])
  updatedBy   User?           @relation("LaporanMingguanUpdater", fields: [updatedById], references: [id])
  detailKitab DetailKitab[]

  @@index([penugasanId])
  @@index([pelaporId])
  @@index([unitId])
  @@index([periodeTahun, periodeMinggu])
  @@index([createdById])
  @@index([updatedById])
}

model DetailKitab {
  id                 String  @id @default(cuid())
  laporanMingguanId  String
  fan                FanIlmu
  namaKitab          String
  frekuensiPertemuan Int

  laporan LaporanMingguan @relation(fields: [laporanMingguanId], references: [id], onDelete: Cascade)

  @@index([laporanMingguanId])
}

model EvaluasiKasus {
  id               String           @id @default(cuid())
  penugasanId      String
  unitId           String?
  judulMasalah     String
  deskripsi        String           @db.Text
  tingkatKeparahan TingkatKeparahan
  statusMediasi    StatusMediasi    @default(MENUNGGU_PUSAT)

  mediatorId     String?
  catatanMediasi String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit      UnitOrganisasi? @relation(fields: [unitId], references: [id])
  penugasan Penugasan       @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  mediator  User?           @relation("Mediator", fields: [mediatorId], references: [id])

  @@index([penugasanId])
  @@index([unitId])
  @@index([statusMediasi])
  @@index([mediatorId])
}

model EvaluasiInduk {
  id          String @id @default(cuid())
  penugasanId String
  lembagaId   String
  unitId      String?

  evaluatorId   String
  initiatedById String

  catatanEvaluasi String  @db.Text
  rekomendasi     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit      UnitOrganisasi? @relation(fields: [unitId], references: [id])
  penugasan Penugasan       @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  lembaga   Lembaga         @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  evaluator User            @relation("Evaluator", fields: [evaluatorId], references: [id])
  initiator User            @relation("Initiator", fields: [initiatedById], references: [id])

  @@index([penugasanId])
  @@index([lembagaId])
  @@index([unitId])
  @@index([evaluatorId])
  @@index([initiatedById])
}

model PermohonanGuruBantu {
  id        String  @id @default(cuid())
  lembagaId String?
  unitId    String?

  namaLembagaPendidikan String
  rtRw                  String
  desaKelurahan         String
  kecamatan             String
  kabupatenKota         String
  provinsi              String
  noTeleponLembaga      String
  mediaSosial           String?

  namaPengasuh          String
  statusPengasuh        StatusPeran
  alumniTahunPengasuh   String?
  statusPengasuhLainnya String?
  noHpPengasuh          String
  fotoPengasuhUrl       String

  namaPJ          String
  statusPJ        StatusPeran
  alumniTahunPJ   String?
  statusPJLainnya String?
  noHpPJ          String
  fotoPJUrl       String

  lokasiMadrasah      LokasiMadrasah
  jenisPendidikan     JenisPendidikan[]
  bahasaKitab         BahasaKitab[]
  bahasaPengantar     BahasaPengantar[]
  jumlahPengurusPutra Int
  jumlahPengurusPutri Int
  jumlahSantriPutra   Int
  jumlahSantriPutri   Int

  jumlahGuruDiminta  Int
  tugasDiamanatkan   String @db.Text
  kitabAkanDiajarkan String @db.Text
  catatanCalonGuru   String @db.Text
  filePdfUrl         String

  statusPermohonan StatusPenugasan @default(DIAJUKAN)
  diajukanOlehId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  unit         UnitOrganisasi?     @relation(fields: [unitId], references: [id])
  lembaga      Lembaga?            @relation(fields: [lembagaId], references: [id])
  diajukanOleh User?               @relation(fields: [diajukanOlehId], references: [id])
  riwayat      RiwayatPermohonan[]

  @@index([lembagaId])
  @@index([unitId])
  @@index([statusPermohonan])
  @@index([diajukanOlehId])
}

// ============================================
// 5. MODELS: PERSURATAN
// ============================================

enum LetterType {
  MASUK
  KELUAR
}

enum LetterStatus {
  DIKETIK
  REVIEW
  APPROVED
  SENT
  ARCHIVED
}

enum LetterAction {
  DIBUAT
  DIEDIT
  DIAJUKAN_REVIEW
  DISETUJUI
  DITOLAK
  DIKIRIM
  DIARSIPKAN
  DIHAPUS
}

model LetterPeriod {
  id           String          @id @default(cuid())
  periodId     String?
  period       PeriodeKhidmat? @relation(fields: [periodId], references: [id])
  namaPeriode  String
  tahunMulai   Int
  tahunSelesai Int
  isActive     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  letters  Letter[]
  counters LetterNumberCounter[]

  @@index([isActive])
  @@index([periodId])
}

model LetterNumberCounter {
  id           String   @id @default(cuid())
  periodId     String
  levelCode    String
  categoryCode String
  currentSeq   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  period LetterPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, levelCode, categoryCode])
  @@index([periodId])
}

model Letter {
  id   String     @id @default(cuid())
  type LetterType

  nomorSurat   String?
  tanggalSurat DateTime @default(now())
  pengirim     String
  penerima     String?
  perihal      String
  isiSurat     String   @db.Text

  fileUrl          String?
  qrCodeUrl        String?
  verificationSlug String? @unique

  status LetterStatus @default(DIKETIK)

  createdById  String
  reviewedById String?
  approvedById String?
  updatedById  String?
  unitId       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy  User           @relation("LetterCreator", fields: [createdById], references: [id])
  reviewedBy User?          @relation("LetterReviewer", fields: [reviewedById], references: [id])
  approvedBy User?          @relation("LetterApprover", fields: [approvedById], references: [id])
  updatedBy  User?          @relation("LetterUpdater", fields: [updatedById], references: [id])
  unit       UnitOrganisasi? @relation(fields: [unitId], references: [id])
  period     LetterPeriod?  @relation(fields: [periodId], references: [id])
  periodId   String?

  logs LetterLog[]

  @@index([type])
  @@index([status])
  @@index([nomorSurat])
  @@index([verificationSlug])
  @@index([createdById])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([unitId])
  @@index([periodId])
  // Daftar surat selalu difilter deletedAt=null lalu diurutkan createdAt desc.
  @@index([deletedAt, createdAt])
}

model LetterLog {
  id        String       @id @default(cuid())
  letterId  String
  action    LetterAction
  userId    String
  notes     String?      @db.Text
  requestId String?
  timestamp DateTime     @default(now())

  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([letterId])
  @@index([userId])
}

// ============================================
// 6. MODELS: PORTAL, FALAK, & AUDIT
// ============================================

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MetodeHisab {
  TASHILUL_AMTSILAH
  KEMENAG_RI
  NU
  MUHAMMADIYAH
}

enum StatusAwalBulan {
  HISAB_LIRBOYO
  MENUNGGU_PEMERINTAH
  RUKYAH
  DIKONFIRMASI
}

model ArticleCategory {
  id        String    @id @default(cuid())
  nama      String
  slug      String    @unique
  urutan    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  articles  Article[]

  @@index([slug])
}

model Article {
  id            String  @id @default(cuid())
  title         String
  slug          String  @unique
  excerpt       String? @db.Text
  content       String  @db.Text
  coverImageUrl String?

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId   String
  categoryId String

  author   User            @relation(fields: [authorId], references: [id])
  category ArticleCategory @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([slug])
  @@index([categoryId])
  @@index([authorId])
  // Daftar artikel publik: filter status lalu urut createdAt desc.
  @@index([status, createdAt])
}

model FalakConfig {
  id             String      @id @default(cuid())
  namaLokasi     String      @default("Markaz Lirboyo Kota Kediri")
  latitude       Float       @default(-7.818758)
  longitude      Float       @default(111.993158)
  ketinggian     Float       @default(76.0)
  metodeHisab    MetodeHisab @default(TASHILUL_AMTSILAH)
  kriteriaMABIMS Boolean     @default(true)
  tinggiHilalMin Float       @default(3.0)
  elongasiMin    Float       @default(6.4)
  koreksiSubuh   Int         @default(0)
  koreksiMaghrib Int         @default(2)
  modeWaktu      String      @default("standar")
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  jadwalShalat JadwalShalat[]

  @@index([isActive])
}

model JadwalShalat {
  id      String   @id @default(cuid())
  tanggal DateTime
  subuh   String
  terbit  String
  dzuhur  String
  ashar   String
  maghrib String
  isya    String

  deklinasiMatahari Float?
  equationOfTime    Float?
  sudutWaktuSubuh   Float?
  sudutWaktuIsya    Float?

  isManualOverride Boolean @default(false)
  catatanOverride  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  configId String
  config   FalakConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@unique([configId, tanggal])
  @@index([tanggal])
  @@index([configId])
}

model PenetapanAwalBulan {
  id                String          @id @default(cuid())
  tahunHijriah      Int
  bulanHijriah      Int
  namaBulan         String
  tanggalMasehi     DateTime
  hariPasaran       String
  tanggalIjtimak    DateTime?
  pukulIjtimak      String?
  terbenamMatahari  String?
  tinggiHilalHakiki String?
  tinggiHilalMari   String?
  elongasi          String?
  lamaHilal         String?
  status            StatusAwalBulan @default(HISAB_LIRBOYO)
  catatan           String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tahunHijriah, bulanHijriah])
  @@index([tahunHijriah, bulanHijriah])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  requestId String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ============================================
// 7. MODELS: SAFARI & PESANTREN RAMADAN
// ============================================

enum StatusDelegasiSafari {
  AKTIF
  GUGUR
  SELESAI
  IZIN
}

enum StatusApprovalJurnal {
  MENUNGGU
  DISETUJUI_PANITIA_DAERAH
  DISETUJUI_PW_PC
  DISETUJUI_KADES
  LENGKAP
}

enum JenjangSekolah {
  SD
  SMP
  SMA
  PERGURUAN_TINGGI
}

enum KondisiKelas {
  TENANG
  RAMAI_TAPI_KONDUSIF
  DISKUSI_BERJALAN_BAIK
  BANYAK_YANG_MENGANTUK
  TIDAK_KONDUSIF
}

enum StatusPenugasanPesantren {
  DITETAPKAN
  BERJALAN
  SELESAI
  EVALUASI_BURUK
}

model TitikSafari {
  id        String  @id @default(cuid())
  unitId    String?
  namaTitik String
  alamat    String  @db.Text
  provinsi  String
  kabupaten String
  kecamatan String
  desa      String
  picNama   String?
  picNoHp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit     UnitOrganisasi?  @relation(fields: [unitId], references: [id])
  delegasi DelegasiSafari[]

  @@index([unitId])
  @@index([provinsi, kabupaten])
}

model DelegasiSafari {
  id      String  @id @default(cuid())
  titikId String
  userId  String
  unitId  String?

  namaLengkap String
  noHp        String
  asalPondok  String?

  status      StatusDelegasiSafari @default(AKTIF)
  alasanGugur String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit           UnitOrganisasi?      @relation(fields: [unitId], references: [id])
  titik          TitikSafari          @relation(fields: [titikId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id])
  jurnalHarian   JurnalHarianSafari[]
  approvalJurnal ApprovalJurnal[]
  laporanSidak   LaporanSidak[]

  @@unique([titikId, userId])
  @@index([titikId])
  @@index([userId])
  @@index([unitId])
  @@index([status])
}

model JurnalHarianSafari {
  id           String   @id @default(cuid())
  delegasiId   String
  tanggal      DateTime
  kegiatan     String   @db.Text
  jumlahJamaah Int?
  catatan      String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  delegasi DelegasiSafari @relation(fields: [delegasiId], references: [id], onDelete: Cascade)

  @@unique([delegasiId, tanggal])
  @@index([delegasiId])
  @@index([tanggal])
}

model ApprovalJurnal {
  id              String    @id @default(cuid())
  delegasiId      String
  approverRole    String
  approverName    String
  approverJabatan String?
  isApproved      Boolean   @default(false)
  tanggalApproval DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  delegasi DelegasiSafari @relation(fields: [delegasiId], references: [id], onDelete: Cascade)

  @@index([delegasiId])
  @@index([approverRole])
}

model LaporanSidak {
  id         String @id @default(cuid())
  delegasiId String
  penilaiId  String

  tanggalSidak    DateTime
  kondisiKegiatan String   @db.Text
  kondisiDelegasi String   @db.Text
  kendala         String?  @db.Text
  rekomendasi     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  delegasi DelegasiSafari @relation(fields: [delegasiId], references: [id], onDelete: Cascade)
  penilai  User           @relation(fields: [penilaiId], references: [id])

  @@index([delegasiId])
  @@index([penilaiId])
}

model SekolahMitra {
  id          String         @id @default(cuid())
  unitId      String?
  namaSekolah String
  jenjang     JenjangSekolah
  alamat      String         @db.Text
  picNama     String
  picNoHp     String
  picJabatan  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit          UnitOrganisasi?        @relation(fields: [unitId], references: [id])
  materiDipilih PilihanMateriSekolah[]
  penugasan     PenugasanPesantren[]

  @@index([unitId])
  @@index([jenjang])
}

model BankMateri {
  id            String         @id @default(cuid())
  judulMateri   String
  deskripsi     String         @db.Text
  targetJenjang JenjangSekolah
  durasiMenit   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pilihanSekolah PilihanMateriSekolah[]
  laporanHarian  LaporanHarianPengajar[]

  @@index([targetJenjang])
}

model PilihanMateriSekolah {
  id        String   @id @default(cuid())
  sekolahId String
  materiId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sekolah SekolahMitra @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  materi  BankMateri   @relation(fields: [materiId], references: [id], onDelete: Cascade)

  @@unique([sekolahId, materiId])
  @@index([sekolahId])
  @@index([materiId])
}

model PenugasanPesantren {
  id            String  @id @default(cuid())
  sekolahId     String
  pengajarId    String
  koordinatorId String
  unitId        String?

  tanggalMulai   DateTime
  tanggalSelesai DateTime
  status         StatusPenugasanPesantren @default(DITETAPKAN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit        UnitOrganisasi? @relation(fields: [unitId], references: [id])
  sekolah     SekolahMitra    @relation(fields: [sekolahId], references: [id], onDelete: Cascade)
  pengajar    User            @relation("PengajarPesantren", fields: [pengajarId], references: [id])
  koordinator User            @relation("KoordinatorPesantren", fields: [koordinatorId], references: [id])

  laporanPengajar    LaporanHarianPengajar[]
  laporanKoordinator LaporanHarianKoordinator[]
  umpanBalikPeserta  UmpanBalikPeserta[]
  umpanBalikPusat    UmpanBalikPusat[]

  @@index([sekolahId])
  @@index([pengajarId])
  @@index([koordinatorId])
  @@index([unitId])
  @@index([status])
}

model LaporanHarianPengajar {
  id          String   @id @default(cuid())
  penugasanId String
  tanggal     DateTime

  kelas        String
  jumlahSiswaL Int
  jumlahSiswaP Int

  materiId          String
  pertanyaanPeserta String? @db.Text

  kondisiKelas     KondisiKelas
  praktikDilakukan Boolean      @default(false)
  catatanTambahan  String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  penugasan PenugasanPesantren @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  materi    BankMateri         @relation(fields: [materiId], references: [id])

  @@index([penugasanId])
  @@index([tanggal])
  @@index([materiId])
}

model LaporanHarianKoordinator {
  id          String   @id @default(cuid())
  penugasanId String
  tanggal     DateTime

  pengajarHadir  Boolean
  kesiapanSarana String? @db.Text
  catatanUmum    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  penugasan PenugasanPesantren @relation(fields: [penugasanId], references: [id], onDelete: Cascade)

  @@index([penugasanId])
  @@index([tanggal])
}

model UmpanBalikPusat {
  id          String @id @default(cuid())
  penugasanId String
  penilaiId   String

  tanggalKunjungan      DateTime
  kondisiSarana         String   @db.Text
  relevansiMateri       String   @db.Text
  kesesuaianKesepakatan String   @db.Text
  rekomendasi           String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  penugasan PenugasanPesantren @relation(fields: [penugasanId], references: [id], onDelete: Cascade)
  penilai   User               @relation(fields: [penilaiId], references: [id])

  @@index([penugasanId])
  @@index([penilaiId])
}

model UmpanBalikPeserta {
  id          String   @id @default(cuid())
  penugasanId String

  jumlahResponden   Int
  ratingKepuasan    Float
  komentarPositif   String? @db.Text
  komentarPerbaikan String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  penugasan PenugasanPesantren @relation(fields: [penugasanId], references: [id], onDelete: Cascade)

  @@index([penugasanId])
}

// ============================================
// 8. MODELS: DAKWAH DIGITAL & DAERAH BINAAN
// ============================================

enum JenisKonten {
  WEBINAR
  PODCAST
  KONTEN_MEDIASOS
  KULTUM_DIGITAL
  TANYA_JAWAB_ONLINE
}

enum StatusKonten {
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
}

enum StatusPendaftaranEvent {
  TERDAFTAR
  HADIR
  TIDAK_HADIR
}

enum StatusDaerahBinaan {
  DIAJUKAN
  AKTIF
  LULUS_GRADUASI
  NON_AKTIF
}

model KontenDakwah {
  id          String       @id @default(cuid())
  unitId      String?
  judul       String
  slug        String       @unique
  deskripsi   String       @db.Text
  jenisKonten JenisKonten
  status      StatusKonten @default(DRAFT)

  thumbnailUrl    String?
  linkVideo       String?
  linkPendaftaran String?

  tanggalEvent DateTime?
  waktuMulai   DateTime?
  waktuSelesai DateTime?
  linkMeeting  String?
  kuotaPeserta Int?

  jumlahPeserta     Int?
  jumlahInteraksi   Int?
  ringkasanFeedback String? @db.Text

  pengunggahId    String
  disetujuiOlehId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  unit           UnitOrganisasi?    @relation(fields: [unitId], references: [id])
  pengunggah     User               @relation("PengunggahKonten", fields: [pengunggahId], references: [id])
  penyetuju      User?              @relation("PenyetujuKonten", fields: [disetujuiOlehId], references: [id])
  pendaftarEvent PendaftaranEvent[]

  @@index([jenisKonten])
  @@index([status])
  @@index([slug])
  @@index([unitId])
  @@index([pengunggahId])
  @@index([disetujuiOlehId])
}

model PendaftaranEvent {
  id           String  @id @default(cuid())
  kontenId     String
  namaPeserta  String
  email        String
  noHp         String
  asalInstansi String?

  statusPendaftaran StatusPendaftaranEvent @default(TERDAFTAR)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  konten KontenDakwah @relation(fields: [kontenId], references: [id], onDelete: Cascade)

  @@index([kontenId])
  @@index([email])
}

model DaerahBinaan {
  id         String  @id @default(cuid())
  unitId     String?
  namaLokasi String
  provinsi   String
  kabupaten  String
  kecamatan  String

  deskripsiKondisi String  @db.Text
  sumberLokasi     String?

  status     StatusDaerahBinaan @default(DIAJUKAN)
  picLokalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unit           UnitOrganisasi?        @relation(fields: [unitId], references: [id])
  picLokal       User?                  @relation(fields: [picLokalId], references: [id])
  laporanBulanan LaporanBulananBinaan[]

  @@index([unitId])
  @@index([provinsi, kabupaten])
  @@index([status])
  @@index([picLokalId])
}

model LaporanBulananBinaan {
  id             String @id @default(cuid())
  daerahBinaanId String
  pelaporId      String

  bulan        Int
  tahun        Int
  tanggalLapor DateTime @default(now())

  kegiatanDilakukan     String  @db.Text
  jumlahPesertaEstimasi Int?
  dampakNaratif         String  @db.Text
  tantanganHambatan     String? @db.Text
  rencanaBulanDepan     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  daerahBinaan DaerahBinaan @relation(fields: [daerahBinaanId], references: [id], onDelete: Cascade)
  pelapor      User         @relation(fields: [pelaporId], references: [id])

  @@unique([daerahBinaanId, tahun, bulan])
  @@index([daerahBinaanId])
  @@index([pelaporId])
  @@index([tahun, bulan])
}

// ============================================
// 9. MODELS: MASTER LEMBAGA & RIWAYAT (LEGACY + WORKFLOW APPROVE)
// ============================================

enum StatusRiwayatPermohonan {
  DIAJUKAN
  DIPENUHI
  TIDAK_DIPENUHI
  REKOMENDASI
}

enum SumberRiwayat {
  EXCEL_LEGACY
  SISTEM
}

model TahunAjaran {
  id           String   @id @default(cuid())
  tahun        String   @unique
  tahunMulai   Int
  tahunSelesai Int
  namaAngkatan String?
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  riwayat RiwayatPermohonan[]

  @@index([isActive])
}

model RiwayatPermohonan {
  id              String                  @id @default(cuid())
  lembagaId       String
  tahunAjaranId   String
  jumlahDiminta   Int?
  jumlahDisetujui Int?
  status          StatusRiwayatPermohonan @default(DIAJUKAN)
  catatanLembaga  String?                 @db.Text
  catatanGb       String?                 @db.Text
  sumber          SumberRiwayat           @default(SISTEM)
  permohonanId    String?
  createdById     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  lembaga     Lembaga              @relation(fields: [lembagaId], references: [id], onDelete: Cascade)
  tahunAjaran TahunAjaran          @relation(fields: [tahunAjaranId], references: [id])
  permohonan  PermohonanGuruBantu? @relation(fields: [permohonanId], references: [id], onDelete: SetNull)
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  guruBantu   RiwayatGuruBantu[]

  @@unique([lembagaId, tahunAjaranId])
  @@index([lembagaId])
  @@index([tahunAjaranId])
  @@index([status])
  @@index([permohonanId])
  @@index([createdById])
}

model RiwayatGuruBantu {
  id            String   @id @default(cuid())
  riwayatId     String
  namaGuruBantu String
  guruBantuId   String?
  penugasanId   String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  riwayat   RiwayatPermohonan @relation(fields: [riwayatId], references: [id], onDelete: Cascade)
  guruBantu GuruBantuProfile? @relation(fields: [guruBantuId], references: [id], onDelete: SetNull)
  penugasan Penugasan?        @relation(fields: [penugasanId], references: [id], onDelete: SetNull)

  @@index([riwayatId])
  @@index([guruBantuId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Apikey {
  id                  String    @id @default(cuid())
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?   @db.Text
  metadata            String?   @db.Text

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
