{
  "$schema": "https://opencode.ai/config.json",

  "lsp": {
    "typescript": {
      "command": ["npx", "-y", "typescript-language-server", "--stdio"]
    }
  },

  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },

    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },

    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/media/linux/New Volume/Folder VS Code/LIM-NextJs"
      ],
      "enabled": true
    },

    "shadcn": {
      "type": "local",
      "command": ["npx", "shadcn@latest", "mcp"],
      "enabled": true
    }
  },

  "provider": {
    "xkiro": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "xKiro",
      "options": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XKIRO_API_KEY}"
      },
      "models": {
        "minimax/minimax-m3:free": { "name": "minimax/minimax-m3:free" },
        "qwen/qwen3.8-max:free": { "name": "qwen/qwen3.8-max:free" }
      }
    }
  }
}
