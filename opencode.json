{
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{file:~/.config/opencode/.secrets/context7-api-key}"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-token}"
        }
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/media/linux/New Volume/Folder VS Code/LIM-NextJs"
        ]
      },
      "shadcn": {
        "type": "local",
        "command": ["npx", "--no-install", "shadcn", "mcp"]
      }
    }
  },
  "providers": {
    "xkiro": {
      "name": "xKiro",
      "env": ["XKIRO_API_KEY"],
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "https://api.xkiro.com/v1",
        "apiKey": "{env:XKIRO_API_KEY}"
      },
      "models": {
        "minimax/minimax-m3:free": {
          "name": "minimax/minimax-m3:free"
        },
        "qwen/qwen3.8-max:free": {
          "name": "qwen/qwen3.8-max:free"
        }
      }
    }
  }
}
